[Unit]
Description=Daily pg_dump of padel_tracker
After=postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=postgres
Group=postgres
ExecStart=/usr/local/bin/padel-db-backup.sh
Nice=10
IOSchedulingClass=idle
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/padel
NoNewPrivileges=true
