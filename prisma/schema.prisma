generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id              String    @id @default(uuid())
  name            String
  email           String    @unique
  username        String?   @unique
  passwordHash    String?
  avatarData      Bytes?
  avatarMimeType  String?
  avatarVersion   Int       @default(0)
  telegramId      BigInt?   @unique
  invitedAt       DateTime  @default(now())
  deletedAt       DateTime?
  emailVerifiedAt DateTime?
  pendingEmail    String?
  termsAcceptedAt DateTime?
  sessionVersion  Int       @default(0)
  activeGroupId   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  emailTokens        EmailToken[]
  participations     GameDayParticipant[]
  matchesScored      Match[]              @relation("ScoredBy")
  jokersUsed         JokerUse[]
  auditLogs          AuditLog[]
  memberships        Membership[]
  invitationsCreated Invitation[]
  invitationUses     InvitationUse[]
  activeGroup        Group?               @relation("ActiveGroup", fields: [activeGroupId], references: [id], onDelete: SetNull)

  // All four player slots of a Match can reference a Player
  matchT1A Match[] @relation("MatchT1A")
  matchT1B Match[] @relation("MatchT1B")
  matchT2A Match[] @relation("MatchT2A")
  matchT2B Match[] @relation("MatchT2B")

  @@index([email])
  @@index([deletedAt])
  @@index([activeGroupId])
}

enum EmailTokenPurpose {
  verify_email
  password_reset
}

model EmailToken {
  id        String            @id @default(uuid())
  playerId  String
  purpose   EmailTokenPurpose
  tokenHash String            @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime          @default(now())
  player    Player            @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, purpose])
}

model Season {
  id        String   @id @default(uuid())
  groupId   String
  name      String
  year      Int
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group     Group      @relation(fields: [groupId], references: [id])
  gameDays  GameDay[]
  jokerUses JokerUse[]

  @@unique([groupId, name])
  @@index([groupId, isActive])
}

enum GameDayStatus {
  planned
  in_progress
  finished
}

model GameDay {
  id          String        @id @default(uuid())
  groupId     String
  seasonId    String
  date        DateTime      @db.Date
  playerCount Int?
  status      GameDayStatus @default(planned)
  seed        String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  group        Group                @relation(fields: [groupId], references: [id])
  season       Season               @relation(fields: [seasonId], references: [id])
  participants GameDayParticipant[]
  matches      Match[]
  jokers       JokerUse[]

  @@unique([seasonId, date])
  @@index([groupId, status])
}

enum AttendanceStatus {
  pending
  confirmed
  declined
  joker
}

model GameDayParticipant {
  id          String           @id @default(uuid())
  gameDayId   String
  playerId    String
  attendance  AttendanceStatus @default(pending)
  respondedAt DateTime?
  createdAt   DateTime         @default(now())

  gameDay GameDay @relation(fields: [gameDayId], references: [id], onDelete: Cascade)
  player  Player  @relation(fields: [playerId], references: [id])

  @@unique([gameDayId, playerId])
  @@index([playerId])
}

model Match {
  id             String    @id @default(uuid())
  gameDayId      String
  matchNumber    Int
  team1PlayerAId String
  team1PlayerBId String
  team2PlayerAId String
  team2PlayerBId String
  team1Score     Int?
  team2Score     Int?
  scoredById     String?
  scoredAt       DateTime?
  version        Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  gameDay      GameDay @relation(fields: [gameDayId], references: [id], onDelete: Cascade)
  team1PlayerA Player  @relation("MatchT1A", fields: [team1PlayerAId], references: [id])
  team1PlayerB Player  @relation("MatchT1B", fields: [team1PlayerBId], references: [id])
  team2PlayerA Player  @relation("MatchT2A", fields: [team2PlayerAId], references: [id])
  team2PlayerB Player  @relation("MatchT2B", fields: [team2PlayerBId], references: [id])
  scoredBy     Player? @relation("ScoredBy", fields: [scoredById], references: [id])

  @@unique([gameDayId, matchNumber])
  @@index([gameDayId])
}

model JokerUse {
  id             String   @id @default(uuid())
  playerId       String
  seasonId       String
  gameDayId      String
  ppgAtUse       Decimal  @db.Decimal(5, 3)
  gamesCredited  Int      @default(15)
  pointsCredited Decimal  @db.Decimal(6, 2)
  createdAt      DateTime @default(now())

  player  Player  @relation(fields: [playerId], references: [id])
  season  Season  @relation(fields: [seasonId], references: [id])
  gameDay GameDay @relation(fields: [gameDayId], references: [id], onDelete: Cascade)

  @@unique([playerId, seasonId, gameDayId])
  @@index([seasonId, playerId])
}

model AuditLog {
  id         String   @id @default(uuid())
  groupId    String?
  actorId    String
  action     String
  entityType String
  entityId   String
  payload    Json?
  createdAt  DateTime @default(now())

  group Group? @relation(fields: [groupId], references: [id])
  actor Player @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([entityType, entityId])
}

model Group {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  seasons     Season[]
  gameDays    GameDay[]
  auditLogs   AuditLog[]
  invitations Invitation[]
  foundedBy   InvitationUse[] @relation("FoundedGroup")
  activeFor   Player[]        @relation("ActiveGroup")
}

enum MembershipRole {
  owner
  admin
  member
}

model Membership {
  id        String         @id @default(uuid())
  groupId   String
  playerId  String
  role      MembershipRole @default(member)
  joinedAt  DateTime       @default(now())
  removedAt DateTime?

  group  Group  @relation(fields: [groupId], references: [id])
  player Player @relation(fields: [playerId], references: [id])

  @@unique([groupId, playerId])
  @@index([playerId])
  @@index([groupId, removedAt])
}

enum InvitationKind {
  founder
  member
}

model Invitation {
  id          String         @id @default(uuid())
  kind        InvitationKind
  groupId     String?
  tokenHash   String         @unique
  createdById String?
  note        String?
  expiresAt   DateTime
  revokedAt   DateTime?
  maxUses     Int            @default(1)
  usedCount   Int            @default(0)
  createdAt   DateTime       @default(now())

  group     Group?          @relation(fields: [groupId], references: [id])
  createdBy Player?         @relation(fields: [createdById], references: [id])
  uses      InvitationUse[]

  @@index([groupId, revokedAt])
}

model InvitationUse {
  id             String   @id @default(uuid())
  invitationId   String
  playerId       String
  usedAt         DateTime @default(now())
  foundedGroupId String?

  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  player       Player     @relation(fields: [playerId], references: [id])
  foundedGroup Group?     @relation("FoundedGroup", fields: [foundedGroupId], references: [id], onDelete: SetNull)

  @@unique([invitationId, playerId])
  @@index([playerId])
}
